  "nodes": [
    {
      "id": "pedido_sucursal",
      "lane": "sucursales",
      "col": 0,
      "type": "frontend",
      "label": "Solicitud Sucursal",
      "sublabel": "Turno y 8 variedades",
      "width": 120
    },
    {
      "id": "registro_pedido",
      "lane": "sucursales",
      "col": 1,
      "type": "database",
      "label": "Registro Firestore",
      "sublabel": "Colección pedidos",
      "width": 124
    },
    {
      "id": "revision_gerencial",
      "lane": "supervision",
      "col": 2,
      "type": "security",
      "label": "Revisión Gerencial",
      "sublabel": "Validación y cupos",
      "width": 124
    },
    {
      "id": "pedido_rechazado",
      "lane": "supervision",
      "col": 3,
      "type": "security",
      "label": "Pedido Denegado",
      "sublabel": "Eliminar de cola",
      "width": 120
    },
    {
      "id": "consolidado_insumos",
      "lane": "produccion",
      "col": 3,
      "type": "backend",
      "label": "Cálculo de Insumos",
      "sublabel": "Consolidado y recetas",
      "width": 124
    },
    {
      "id": "descuento_stock",
      "lane": "produccion",
      "col": 4,
      "type": "database",
      "label": "Deducción Stock",
      "sublabel": "Estado PROCESADO",
      "width": 124
    },
    {
      "id": "emision_remision",
      "lane": "distribucion",
      "col": 4,
      "type": "frontend",
      "label": "Remisión y Factura",
      "sublabel": "jsPDF y entrega",
      "width": 124
    },
    {
      "id": "alertas_ruta",
      "lane": "distribucion",
      "col": 3,
      "type": "messagebus",
      "label": "Alertas de Ruta",
      "sublabel": "Incidentes en reparto",
      "width": 120
    }
  ],
  "edges": [
    {
      "id": "envio_solicitud",
      "from": "pedido_sucursal",
      "to": "registro_pedido",
      "label": "registrarPedido",
      "variant": "default"
    },
    {
      "id": "cola_revision",
      "from": "registro_pedido",
      "to": "revision_gerencial",
      "label": "PENDIENTE",
      "variant": "emphasis"
    },
    {
      "id": "aprobacion_pedido",
      "from": "revision_gerencial",
      "to": "consolidado_insumos",
      "label": "APROBADO",
      "variant": "emphasis"
    },
    {
      "id": "rechazo_pedido_edge",
      "from": "revision_gerencial",
      "to": "pedido_rechazado",
      "label": "denegado",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "procesar_batch",
      "from": "consolidado_insumos",
      "to": "descuento_stock",
      "label": "procesarProduccion",
      "variant": "emphasis"
    },
    {
      "id": "generar_factura",
      "from": "descuento_stock",
      "to": "emision_remision",
      "label": "descargar PDF",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "id": "seguimiento_entrega",
      "from": "alertas_ruta",
      "to": "emision_remision",
      "label": "confirmación",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Control y Trazabilidad",
      "items": [
        "Validación gerencial previa a producción"
      ]
    },
    {
      "dot": "emerald",
      "title": "Producción y Despacho",
      "items": [
        "Deducción de insumos y remisión en PDF"
      ]
    }
  ]
}
