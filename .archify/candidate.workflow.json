{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Panadería San Carlos — Flujo Operativo de Pedidos y Producción",
    "output": "./workflow.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "flujo_completo",
        "label": "Flujo de Operación Integral",
        "focus": [
          "pedido_sucursal",
          "registro_pedido",
          "revision_gerencial",
          "consolidado_insumos",
          "descuento_stock",
          "emision_remision"
        ],
        "note": "Ruta principal desde la solicitud en sucursal hasta el despacho y facturación."
      },
      {
        "id": "control_gerencial",
        "label": "Supervisión y Aprobación",
        "focus": [
          "revision_gerencial",
          "pedido_rechazado",
          "consolidado_insumos"
        ],
        "note": "Compuerta de seguridad donde gerencia autoriza o rechaza pedidos."
      },
      {
        "id": "produccion_logistica",
        "label": "Taller y Distribución",
        "focus": [
          "consolidado_insumos",
          "descuento_stock",
          "emision_remision",
          "alertas_ruta"
        ],
        "note": "Explosión de materias primas, actualización de inventario y salida a ruta."
      }
    ]
  },
  "lanes": [
    { "id": "sucursales", "label": "Portal Sucursales" },
    { "id": "supervision", "label": "Supervisión Gerencial" },
    { "id": "produccion", "label": "Taller de Producción" },
    { "id": "distribucion", "label": "Distribución y Remisión" }
  ],
  "phases": [
    { "id": "fase_solicitud", "label": "1. Captura de Pedido", "fromCol": 0, "toCol": 1 },
    { "id": "fase_revision", "label": "2. Control y Aprobación", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "fase_produccion", "label": "3. Explosión de Insumos", "fromCol": 3, "toCol": 3, "variant": "default" },
    { "id": "fase_cierre", "label": "4. Despacho y Remisión", "fromCol": 4, "toCol": 4, "variant": "dashed" }
  ],
  "groups": [
    { "id": "grupo_supervision", "label": "Filtro de integridad", "lane": "supervision", "fromCol": 2, "toCol": 3, "variant": "security" },
    { "id": "grupo_produccion", "label": "Batch de panificación", "lane": "produccion", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "grupo_despacho", "label": "Entrega y auditoría", "lane": "distribucion", "fromCol": 3, "toCol": 4, "variant": "dashed" }
